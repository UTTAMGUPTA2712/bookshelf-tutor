{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bookshelf Tutor",
  "version": "0.1.0",
  "identifier": "com.bookshelf.tutor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bookshelf Tutor",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/pdfium/*": "resources/pdfium/"
    },
    "category": "Education",
    "shortDescription": "Learn from your own library of programming books"
  }
}